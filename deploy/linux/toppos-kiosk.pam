# /etc/pam.d/toppos-kiosk — sesija servisa toppos-kiosk (PAMName): pam_systemd pravi logind sesiju na seat0, pa kiosk
# dobija ekran, ulaz (touch) i zvuk bez dodatnih grupa, i korisnički D-Bus/XDG_RUNTIME_DIR.
auth     required pam_unix.so nullok
account  required pam_unix.so
session  required pam_unix.so
session  required pam_systemd.so
