{
  "Locker": {
    "ModuleCount": 2,
    "BoxCountPerModule": 24
  },
  "LockController": {
    "Type": "NCU24L",
    "ComPort": { "PortName": "COM255", "BaudRate": 115200, "DataBits": 8, "Parity": "None" },
    "TcpController": { "IpAddress": "127.0.0.1", "Port": {{LockerTcpPort}} },
    "ListenAddress": "127.0.0.1"
  },
  "BarcodeScanner": {
    "ComPort": { "PortName": "{{ScannerSimulatorPort}}", "BaudRate": 9600, "DataBits": 8, "Parity": "None" },
    "CarriageReturnBarcodeTermination": true
  },
  "PosTerminal": {
    "ComPort": { "PortName": "{{PosSimulatorPort}}", "BaudRate": 9600, "DataBits": 8, "Parity": "None" },
    "Pin": "1234",
    "Tid": "SIMT0001",
    "CardWaitTimeoutSeconds": 30,
    "SpeedFactor": 0.5
  },
  "ControlApi": {
    "Port": {{LockerApiPort}}
  }
}
