<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testovi jezgra kioska (v2 Tests/TopPos.Workflow.Tests bez WPF-a); rade na Windows-u i Linuxu. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- LibVLC za test zvuka (TOPPOS_AUDIO_TEST_FILE); na Linuxu je sistemska biblioteka -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TopPos.Kiosk.Core/TopPos.Kiosk.Core.csproj" />
    <ProjectReference Include="../../src/TopPos.LockController.NCU16L/TopPos.LockController.NCU16L.csproj" />
    <ProjectReference Include="../../src/TopPos.LockController.NCU24L/TopPos.LockController.NCU24L.csproj" />
    <ProjectReference Include="../../src/TopPos.LockController.Serial/TopPos.LockController.Serial.csproj" />
    <ProjectReference Include="../../src/TopPos.LockController.SerialDailyExpress/TopPos.LockController.SerialDailyExpress.csproj" />
  </ItemGroup>

</Project>