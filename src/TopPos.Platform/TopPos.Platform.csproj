<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Platformski sloj (doc/plan.md, sekcija 1a): interfejsi i implementacije za Windows i Linux. Platformu proverava samo
  PlatformServices; ostatak koda koristi interfejse.
  -->
  <PropertyGroup>
    <!-- LibraryImport (P/Invoke izvorni generator) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bez nativne LibVLC biblioteke: na Windows-u je dodaje aplikacija (VideoLAN.LibVLC.Windows), na Linuxu je sistemska. -->
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flatsoft.Common.UI\Flatsoft.Common.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TopPos.Kiosk.Tests" />
  </ItemGroup>

</Project>