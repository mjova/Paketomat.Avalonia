{
  "Serilog": {
	"Using": [ "Serilog.Sinks.File", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%TOPPOS_LOG_DIR%/log-%TOPPOS_LOGFILE_TAG%-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}",
          "hooks": "TopPos.Kiosk.Logging.SerilogHooks::RollingFileHeaderWriter, TopPos.Kiosk"
        }
      }
    ]
  }
}
