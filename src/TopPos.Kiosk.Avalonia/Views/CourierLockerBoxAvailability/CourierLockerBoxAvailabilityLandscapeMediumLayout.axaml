<!-- v2 Pages/CourierLockerBoxAvailabilityPage/CourierLockerBoxAvailabilityPageLandscapeMediumLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.CourierLockerBoxAvailabilityLandscapeMediumLayout"
             x:DataType="vm:CourierLockerBoxAvailabilityViewModel">
	<Grid RowDefinitions="*,Auto">
		<!-- Gore: stanje upita i spinner, a kad stigne odgovor tabela po veličinama sanduka -->
		<Border Grid.Row="0" Classes="info"
				HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Padding="24" Margin="24">
			<Panel>
				<StackPanel IsVisible="{Binding BoxSizeAvailabilityStatuses, Converter={x:Static ObjectConverters.IsNull}}">
					<TextBlock Classes="title" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4 4 4 48"/>
					<!-- v2 Flatsoft.Common.UI Spinner -->
					<Panel Width="128" Height="128">
						<Ellipse Stroke="#FF0078D7" StrokeThickness="8" Opacity="0.3"/>
						<Ellipse Classes="spinner" Stroke="#FF0078D7" StrokeThickness="8" StrokeDashArray="4,8" StrokeLineCap="Round"/>
					</Panel>
				</StackPanel>
				<c:BoxSizeAvailabilityStatus HorizontalAlignment="Center" VerticalAlignment="Center"
											 IsVisible="{Binding BoxSizeAvailabilityStatuses, Converter={x:Static ObjectConverters.IsNotNull}}"/>
			</Panel>
		</Border>
		<!-- Dole: Dalje -->
		<Button Grid.Row="1"
				Classes="animated"
				Content="{Binding [General.Next]}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				MinWidth="200"
				AutomationProperties.AutomationId="CourierLockerBoxAvailabilityPage.Complete"
				Command="{Binding CompleteCommand}"
				Margin="4 48 4 16"/>
	</Grid>
</UserControl>