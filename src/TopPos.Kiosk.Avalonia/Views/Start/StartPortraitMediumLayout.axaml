<!-- v2 Pages/StartPage/StartPagePortraitMediumLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.StartPortraitMediumLayout"
             x:DataType="vm:StartViewModel">
	<Panel>
		<DockPanel>
			<Border DockPanel.Dock="Top" Height="120"/>
			<!-- PNG ima 216 DPI: WPF ga je (Stretch=None) prikazivao kao 519×481 px · 96/216; Avalonia DPI iz fajla ne koristi. -->
			<Image DockPanel.Dock="Top" Source="/Resources/box-start.png" Width="231" Height="214" Margin="8"/>
			<Border DockPanel.Dock="Bottom" Height="70"/>
			<!-- „Ostavi paket“ (odluka korisnika 27.11.2026, v2 ga ovde nema) iznad „Preuzmi paket“, kao u PortraitSmall: jedno
				 pored drugog dodiruju QR u uglu. -->
			<Button DockPanel.Dock="Bottom"
					Classes="animated"
					Content="{Binding [StartPage.PickUpPackage]}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Width="340"
					AutomationProperties.AutomationId="StartPage.RecipientPickUpPackage"
					Command="{Binding RecipientPickUpPackageCommand}"/>
			<Border DockPanel.Dock="Bottom" Height="40" IsVisible="{Binding IsPackageDepositionEnabled}"/>
			<Button DockPanel.Dock="Bottom"
					Classes="animated"
					Content="{Binding [StartPage.DepositPackage]}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Width="340"
					IsVisible="{Binding IsPackageDepositionEnabled}"
					AutomationProperties.AutomationId="StartPage.SenderDepositPackage"
					Command="{Binding SenderDepositPackageCommand}"/>
			<!-- v2 prazan TextBlock: puni ostatak, da dugme ostane dole. -->
			<Border/>
		</DockPanel>
		<!-- Identifikacija paketomata (QR + čitljiv ispis), u donjem desnom uglu. -->
		<c:LockerQrCode Code="{Binding LockerQrCodeText}"
						QrSize="110"
						LabelFontSize="14"
						TextElement.Foreground="WhiteSmoke"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Margin="0 0 24 16"/>
	</Panel>
</UserControl>