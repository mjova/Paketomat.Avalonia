<!-- v2 Pages/RecipientCodeInputPage/RecipientCodeInputPageLandscapeLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.RecipientCodeInputView"
             AutomationProperties.AutomationId="Page.RecipientCodeInputPage"
             x:DataType="vm:RecipientCodeInputViewModel">
	<Grid ColumnDefinitions="2*,*,2*">
		<!-- Levo: uputstvo i animacija skeniranja QR koda -->
		<Grid Grid.Column="0" RowDefinitions="7*,4*">
			<Border Grid.Row="0" Grid.RowSpan="2" Classes="info"
					HorizontalAlignment="Center" VerticalAlignment="Top"
					Padding="18" Margin="48 4 4 4">
				<StackPanel>
					<TextBlock Classes="title" Text="{Binding [RecipientCodeInputPage.InstructionsTitle]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoices]}" Margin="4 12"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.1]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.Or]}" HorizontalAlignment="Center"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.2]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.NextStep]}" Margin="4 12"/>
				</StackPanel>
			</Border>
			<!-- v2 Controls/QRCode: uzorak QR koda i crvena linija koja ga skenira -->
			<Panel Grid.Row="1" Width="140" Height="140" Background="WhiteSmoke" ClipToBounds="True">
				<Image Source="{StaticResource di_toppos_rs_qr_code_sample_xaml}"/>
				<Rectangle Classes="scanline" Height="3" Fill="Red" VerticalAlignment="Top"/>
			</Panel>
		</Grid>
		<!-- Sredina: telefon i strelica ka tastaturi -->
		<Grid Grid.Column="1" RowDefinitions="*,*">
			<Image Grid.Row="0" Source="/Resources/telefon.png" Margin="32"/>
			<Path Grid.Row="1" Classes="bounce"
				  Data="{StaticResource DownArrowGeometry}"
				  Fill="Red"
				  Stretch="Uniform"
				  Width="80" Height="120"
				  HorizontalAlignment="Center"
				  VerticalAlignment="Top"
				  Margin="8 48 8 8"/>
		</Grid>
		<!-- Desno: numerička tastatura -->
		<c:NumericKeypad Grid.Column="2"
						 DataContext="{Binding Keypad}"
						 VerticalAlignment="Top"
						 Margin="32"/>
	</Grid>
</UserControl>