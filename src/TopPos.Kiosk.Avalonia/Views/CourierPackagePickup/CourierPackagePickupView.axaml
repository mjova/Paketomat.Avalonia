<!-- v2 Pages/CourierPackagePickupPage/CourierPackagePickupPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.CourierPackagePickupView"
             AutomationProperties.AutomationId="Page.CourierPackagePickupPage"
             x:DataType="vm:CourierPackagePickupViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.LandscapeSmallTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupLandscapeSmallLayout/></DataTemplate>
		</c:LayoutContent.LandscapeSmallTemplate>
		<c:LayoutContent.PortraitLargeTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupPortraitLayout/></DataTemplate>
		</c:LayoutContent.PortraitLargeTemplate>
		<c:LayoutContent.PortraitMediumTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupPortraitMediumLayout/></DataTemplate>
		</c:LayoutContent.PortraitMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:CourierPackagePickupViewModel"><views:CourierPackagePickupPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
