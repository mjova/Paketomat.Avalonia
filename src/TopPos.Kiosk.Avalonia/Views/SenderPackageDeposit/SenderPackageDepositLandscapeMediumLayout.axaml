<!-- v2 Pages/SenderPackageDepositPage/SenderPackageDepositPageLandscapeMediumLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             x:Class="TopPos.Kiosk.UI.Views.SenderPackageDepositLandscapeMediumLayout"
             x:DataType="vm:SenderPackageDepositViewModel">
	<Grid RowDefinitions="*,*">
		<Image Grid.Row="0" Grid.RowSpan="2" Classes="zoom"
			   Source="/Resources/courier-package-deposit.png"
			   Stretch="UniformToFill"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center"/>
		<Border Grid.Row="0" Grid.RowSpan="2" Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
			<StackPanel>
				<TextBlock Text="{Binding [SenderPackageDepositPage.DepositInstructions]}"
						   FontSize="32" Foreground="{DynamicResource InformationForegroundColor}" TextWrapping="Wrap"/>
				<TextBlock Text="{Binding Barcode}"
						   FontSize="32" Foreground="{DynamicResource AccentedForegroundColor1}" HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
		<!-- Dole: veće sanduče / Odustani. v2 ne vezuje CanChangeBoxSize/CanCancel za dugmad (ostaju uključena), isto ovde. -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*">
			<Button Grid.Column="0"
					Classes="animated"
					Content="{Binding [SenderPackageDepositPage.ChangeBoxSize]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					AutomationProperties.AutomationId="SenderPackageDepositPage.ChangeBoxSize"
					Command="{Binding ChangeBoxSizeCommand}"/>
			<Button Grid.Column="1"
					Classes="animated"
					Content="{Binding [SenderPackageDepositPage.Cancel]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					AutomationProperties.AutomationId="SenderPackageDepositPage.Cancel"
					Command="{Binding CancelCommand}"/>
		</Grid>
	</Grid>
</UserControl>