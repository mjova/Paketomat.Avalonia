<!-- v2 Pages/CourierDepositConfirmationPage/CourierDepositConfirmationPagePortraitSmallLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             x:Class="TopPos.Kiosk.UI.Views.CourierDepositConfirmationPortraitSmallLayout"
             x:DataType="vm:CourierDepositConfirmationViewModel">
	<Grid RowDefinitions="*,*">
		<Image Grid.Row="0" Grid.RowSpan="2" Classes="zoom"
			   Source="/Resources/courier-package-deposit.png"
			   Stretch="UniformToFill"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center"/>
		<Border Grid.Row="0" Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="64">
			<!-- Prelamanje: na 600 px pitanje u jednom redu ne staje (v2 bez prelamanja; Inter je širi od Segoe UI) -->
			<TextBlock Text="{Binding [CourierDepositConfirmationPage.DepositConfirmationQuestion]}"
					   FontSize="32" TextWrapping="Wrap" TextAlignment="Center"
					   Foreground="{DynamicResource InformationForegroundColor}"/>
		</Border>
		<!-- Dole: Ne / Da -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*">
			<Button Grid.Column="0"
					Classes="animated"
					Content="{Binding [General.No]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					MinWidth="200"
					AutomationProperties.AutomationId="CourierDepositConfirmationPage.Cancel"
					Command="{Binding CancelCommand}"/>
			<Button Grid.Column="1"
					Classes="animated"
					Content="{Binding [General.Yes]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					MinWidth="200"
					AutomationProperties.AutomationId="CourierDepositConfirmationPage.Confirm"
					Command="{Binding ConfirmCommand}"/>
		</Grid>
	</Grid>
</UserControl>