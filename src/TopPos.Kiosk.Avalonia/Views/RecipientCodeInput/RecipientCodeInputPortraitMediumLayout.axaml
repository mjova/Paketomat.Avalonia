<!-- v2 Pages/RecipientCodeInputPage/RecipientCodeInputPagePortraitMediumLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.RecipientCodeInputPortraitMediumLayout"
             x:DataType="vm:RecipientCodeInputViewModel">
	<UserControl.Styles>
		<!-- Kao Rectangle.scanline (Styles/Kiosk.axaml), ali za QR 200×200: linija ide do dna (200 − 3). -->
		<Style Selector="Rectangle.scanline200">
			<Setter Property="RenderTransform">
				<TranslateTransform/>
			</Setter>
			<Style.Animations>
				<Animation Duration="0:0:2" IterationCount="Infinite" PlaybackDirection="Alternate">
					<KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="197"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>
	<Grid ColumnDefinitions="*,Auto,*">
		<!-- Levo: uputstvo i animacija skeniranja QR koda -->
		<Grid Grid.Column="0" RowDefinitions="5*,4*">
			<Border Grid.Row="0" Grid.RowSpan="2" Classes="info"
					HorizontalAlignment="Center" VerticalAlignment="Top"
					Padding="24" Margin="32 32 32 4">
				<StackPanel>
					<TextBlock Classes="title" Text="{Binding [RecipientCodeInputPage.InstructionsTitle]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoices]}" Margin="4 16"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.1]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.Or]}" HorizontalAlignment="Center"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.InputChoice.2]}"/>
					<TextBlock Classes="text" Text="{Binding [RecipientCodeInputPage.NextStep]}" Margin="4 16"/>
				</StackPanel>
			</Border>
			<!-- v2 Controls/QRCode: uzorak QR koda i crvena linija koja ga skenira -->
			<Panel Grid.Row="1" Width="200" Height="200" Background="WhiteSmoke" ClipToBounds="True">
				<Image Source="{StaticResource di_toppos_rs_qr_code_sample_xaml}"/>
				<Rectangle Classes="scanline200" Height="3" Fill="Red" VerticalAlignment="Top"/>
			</Panel>
		</Grid>
		<!-- Sredina: samo strelica ka tastaturi (v2 Portrait bez slike telefona). Kolona je Auto: v2 strelicu meri u prirodnoj
			 veličini (20×30) i uvećava je ×4 tek pri crtanju, pa kolona ostaje uska. Canvas zauzima isto (20×30 + margine), a
			 strelica 80×120 se crta preko njega, centrirana kao u Landscape-u. -->
		<Grid Grid.Column="1" RowDefinitions="*,*">
			<Canvas Grid.Row="1"
					Width="20" Height="30"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Margin="8 48 8 8">
				<Path Classes="bounce"
					  Canvas.Left="-30"
					  Data="{StaticResource DownArrowGeometry}"
					  Fill="Red"
					  Stretch="Uniform"
					  Width="80" Height="120"/>
			</Canvas>
		</Grid>
		<!-- Desno: numerička tastatura (v2 SmallNumericKeypadStyle: 270×400, FontSize 24, SemiBold) -->
		<c:NumericKeypad Grid.Column="2"
						 DataContext="{Binding Keypad}"
						 Classes="small"
						 VerticalAlignment="Top"
						 Margin="20"/>
	</Grid>
</UserControl>