<!-- v2 Pages/RecipientCodeInputPage/RecipientCodeInputPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.RecipientCodeInputView"
             AutomationProperties.AutomationId="Page.RecipientCodeInputPage"
             x:DataType="vm:RecipientCodeInputViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.LandscapeSmallTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputLandscapeSmallLayout/></DataTemplate>
		</c:LayoutContent.LandscapeSmallTemplate>
		<c:LayoutContent.PortraitLargeTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputPortraitLayout/></DataTemplate>
		</c:LayoutContent.PortraitLargeTemplate>
		<c:LayoutContent.PortraitMediumTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputPortraitMediumLayout/></DataTemplate>
		</c:LayoutContent.PortraitMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:RecipientCodeInputViewModel"><views:RecipientCodeInputPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
