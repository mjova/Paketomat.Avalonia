<!-- v2 Pages/CourierBarcodeScanPage/CourierBarcodeScanPageLandscapeMediumLayout.xaml (preuzimanje i ostavljanje kurira) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.CourierBarcodeScanLandscapeMediumLayout"
             x:DataType="vm:CourierBarcodeScanViewModel">
	<Grid RowDefinitions="*,*,*">
		<c:Barcode Grid.Row="0" RenderTransformOrigin="50%,50%">
			<c:Barcode.RenderTransform>
				<TransformGroup>
					<ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
					<TranslateTransform Y="10"/>
				</TransformGroup>
			</c:Barcode.RenderTransform>
		</c:Barcode>
		<Border Grid.Row="1" Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
			<StackPanel>
				<TextBlock Text="{Binding [CourierBarcodeScanPage.ScanPickedUpPackage]}"
						   FontSize="32" Foreground="{DynamicResource InformationForegroundColor}"
						   IsVisible="{Binding PackagePickup}"/>
				<TextBlock Text="{Binding Barcode}"
						   FontSize="32" Foreground="{DynamicResource AccentedForegroundColor1}" HorizontalAlignment="Center"
						   IsVisible="{Binding PackagePickup}"/>
				<TextBlock Text="{Binding [CourierBarcodeScanPage.ScanPackageToDeposit]}"
						   FontSize="32" Foreground="{DynamicResource InformationForegroundColor}"
						   IsVisible="{Binding PackageDeposit}"/>
			</StackPanel>
		</Border>
		<Grid Grid.Row="2" ColumnDefinitions="*,*">
			<Button Grid.Column="1"
					Classes="animated"
					Content="{Binding [General.LogOut]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Margin="4"
					AutomationProperties.AutomationId="CourierBarcodeScanPage.Cancel"
					IsVisible="{Binding PackageDeposit}"
					Command="{Binding CancelCommand}"/>
		</Grid>
	</Grid>
</UserControl>