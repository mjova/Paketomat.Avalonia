<!-- v2 Pages/CourierBarcodeScanPage/CourierBarcodeScanPagePortraitSmallLayout.xaml (preuzimanje i ostavljanje kurira) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.CourierBarcodeScanPortraitSmallLayout"
             x:DataType="vm:CourierBarcodeScanViewModel">
	<Grid RowDefinitions="*,*,*">
		<c:Barcode Grid.Row="0"/>
		<Border Grid.Row="1" Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Margin="48">
			<StackPanel>
				<TextBlock Text="{Binding [CourierBarcodeScanPage.ScanPickedUpPackage]}"
						   FontSize="30" TextWrapping="Wrap" Foreground="{DynamicResource InformationForegroundColor}"
						   IsVisible="{Binding PackagePickup}"/>
				<TextBlock Text="{Binding Barcode}"
						   FontSize="30" Foreground="{DynamicResource AccentedForegroundColor1}" HorizontalAlignment="Center"
						   IsVisible="{Binding PackagePickup}"/>
				<TextBlock Text="{Binding [CourierBarcodeScanPage.ScanPackageToDeposit]}"
						   FontSize="30" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource InformationForegroundColor}"
						   IsVisible="{Binding PackageDeposit}"/>
			</StackPanel>
		</Border>
		<Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,*">
			<Button Grid.Column="1"
					Classes="animated"
					Content="{Binding [General.LogOut]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Margin="4"
					AutomationProperties.AutomationId="CourierBarcodeScanPage.Cancel"
					IsVisible="{Binding PackageDeposit}"
					Command="{Binding CancelCommand}"/>
		</Grid>
	</Grid>
</UserControl>