<!-- v2 Pages/CourierBarcodeScanPage/CourierBarcodeScanPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.CourierBarcodeScanView"
             AutomationProperties.AutomationId="Page.CourierBarcodeScanPage"
             x:DataType="vm:CourierBarcodeScanViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.LandscapeSmallTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanLandscapeSmallLayout/></DataTemplate>
		</c:LayoutContent.LandscapeSmallTemplate>
		<c:LayoutContent.PortraitLargeTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanPortraitLayout/></DataTemplate>
		</c:LayoutContent.PortraitLargeTemplate>
		<c:LayoutContent.PortraitMediumTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanPortraitMediumLayout/></DataTemplate>
		</c:LayoutContent.PortraitMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:CourierBarcodeScanViewModel"><views:CourierBarcodeScanPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
