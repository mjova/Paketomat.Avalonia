<!-- v2 Pages/SenderBarcodeScanPage/SenderBarcodeScanPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.SenderBarcodeScanView"
             AutomationProperties.AutomationId="Page.SenderBarcodeScanPage"
             x:DataType="vm:SenderBarcodeScanViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:SenderBarcodeScanViewModel"><views:SenderBarcodeScanLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:SenderBarcodeScanViewModel"><views:SenderBarcodeScanLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:SenderBarcodeScanViewModel"><views:SenderBarcodeScanPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
