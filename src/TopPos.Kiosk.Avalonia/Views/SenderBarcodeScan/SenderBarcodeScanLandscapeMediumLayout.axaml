<!-- v2 Pages/SenderBarcodeScanPage/SenderBarcodeScanPageLandscapeMediumLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             x:Class="TopPos.Kiosk.UI.Views.SenderBarcodeScanLandscapeMediumLayout"
             x:DataType="vm:SenderBarcodeScanViewModel">
	<Grid RowDefinitions="*,*,*">
		<c:Barcode Grid.Row="0" RenderTransformOrigin="50%,50%">
			<c:Barcode.RenderTransform>
				<TransformGroup>
					<ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
					<TranslateTransform Y="10"/>
				</TransformGroup>
			</c:Barcode.RenderTransform>
		</c:Barcode>
		<Border Grid.Row="1" Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
			<TextBlock Text="{Binding [SenderBarcodeScanPage.ScanPackageToDeposit]}"
					   FontSize="32" Foreground="{DynamicResource InformationForegroundColor}"/>
		</Border>
		<Grid Grid.Row="2" ColumnDefinitions="*,*">
			<Button Grid.Column="1"
					Classes="animated"
					Content="{Binding [SenderBarcodeScanPage.Cancel]}"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Margin="4"
					AutomationProperties.AutomationId="SenderBarcodeScanPage.Cancel"
					Command="{Binding CancelCommand}"/>
		</Grid>
	</Grid>
</UserControl>