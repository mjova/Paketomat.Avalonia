<!-- v2 Pages/DepositConfirmationFailedPage/DepositConfirmationFailedPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.DepositConfirmationFailedView"
             AutomationProperties.AutomationId="Page.DepositConfirmationFailedPage"
             x:DataType="vm:DepositConfirmationFailedViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.LandscapeSmallTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedLandscapeSmallLayout/></DataTemplate>
		</c:LayoutContent.LandscapeSmallTemplate>
		<c:LayoutContent.PortraitLargeTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedPortraitLayout/></DataTemplate>
		</c:LayoutContent.PortraitLargeTemplate>
		<c:LayoutContent.PortraitMediumTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedPortraitMediumLayout/></DataTemplate>
		</c:LayoutContent.PortraitMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:DepositConfirmationFailedViewModel"><views:DepositConfirmationFailedPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
