<!-- v2 Pages/RecipientPackagePIckupPage/RecipientPackagePickupPagePortraitSmallLayout.xaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             x:Class="TopPos.Kiosk.UI.Views.RecipientPackagePickupPortraitSmallLayout"
             x:DataType="vm:RecipientPackagePickupViewModel">
	<Panel>
		<Image Classes="zoom"
			   Source="/Resources/recipient-package-pickup.png"
			   Stretch="UniformToFill"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center"/>
		<Border Classes="info" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="42">
			<TextBlock Text="{Binding PickupInstructions}"
					   FontSize="28"
					   TextWrapping="Wrap"
					   Foreground="{DynamicResource InformationForegroundColor}"/>
		</Border>
	</Panel>
</UserControl>