<!-- v2 Pages/RecipientPackagePIckupPage/RecipientPackagePickupPage.xaml: stranica u layoutu po veličini prozora (LayoutContent) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TopPos.Kiosk.ViewModels"
             xmlns:c="using:TopPos.Kiosk.UI.Controls"
             xmlns:views="using:TopPos.Kiosk.UI.Views"
             x:Class="TopPos.Kiosk.UI.Views.RecipientPackagePickupView"
             AutomationProperties.AutomationId="Page.RecipientPackagePickupPage"
             x:DataType="vm:RecipientPackagePickupViewModel">
	<c:LayoutContent Content="{Binding}">
		<c:LayoutContent.LandscapeLargeTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupLandscapeLayout/></DataTemplate>
		</c:LayoutContent.LandscapeLargeTemplate>
		<c:LayoutContent.LandscapeMediumTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupLandscapeMediumLayout/></DataTemplate>
		</c:LayoutContent.LandscapeMediumTemplate>
		<c:LayoutContent.LandscapeSmallTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupLandscapeSmallLayout/></DataTemplate>
		</c:LayoutContent.LandscapeSmallTemplate>
		<c:LayoutContent.PortraitLargeTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupPortraitLayout/></DataTemplate>
		</c:LayoutContent.PortraitLargeTemplate>
		<c:LayoutContent.PortraitMediumTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupPortraitMediumLayout/></DataTemplate>
		</c:LayoutContent.PortraitMediumTemplate>
		<c:LayoutContent.PortraitSmallTemplate>
			<DataTemplate x:DataType="vm:RecipientPackagePickupViewModel"><views:RecipientPackagePickupPortraitSmallLayout/></DataTemplate>
		</c:LayoutContent.PortraitSmallTemplate>
	</c:LayoutContent>
</UserControl>
