<!--
Glavni prozor kioska: v2 MainWindow.xaml; zaglavlje, koraci, stranica i podnožje su u šest layouta (Views/MainWindow,
v2 MainWindow*Layout.xaml + Steps.xaml), izbor po veličini prozora (LayoutContent).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TopPos.Kiosk.ViewModels"
        xmlns:views="using:TopPos.Kiosk.UI.Views"
        xmlns:c="using:TopPos.Kiosk.UI.Controls"
        x:Class="TopPos.Kiosk.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Paketomat"
        Icon="/Resources/box-start.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        Background="{DynamicResource ApplicationBackgroundColor}">

	<Window.Styles>
		<!-- v2 Steps.xaml: izabran korak ima žuti okvir sa senkom. -->
		<Style Selector="Border.step">
			<Setter Property="BorderThickness" Value="4"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Margin" Value="8"/>
		</Style>
		<Style Selector="Border.step.selected">
			<Setter Property="BorderBrush" Value="Yellow"/>
			<Setter Property="BoxShadow" Value="10 10 10 0 #E6000000"/>
		</Style>
		<Style Selector="Button.header">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Styles>

	<Panel>
		<!-- Dok se uređaji ne provere (v2: prozor se pojavljivao tek posle njih). -->
		<TextBlock x:Name="StartupMessage"
				   Text="Inicijalizacija…"
				   FontSize="32"
				   Foreground="WhiteSmoke"
				   TextWrapping="Wrap"
				   Margin="48"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"/>

		<!-- Kiosk (sadržaj i slojevi) se prikazuje tek sa ViewModel-om; ugašen je dok paketomat nije u funkciji (v2: ceo prozor),
			 osim tokom servisne sesije (IsKioskInputEnabled), i dok je otvoren status uređaja (v2: modalni prozor) — pozadina sloja
			 zaustavlja dodir, a ovo i tastaturu. Posle zatvaranja ostaje ugašen dok otkazane provere drže kiosk zauzetim. -->
		<Panel x:Name="Kiosk"
			   IsVisible="False">
			<Panel.IsEnabled>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<Binding Path="IsKioskInputEnabled"/>
					<Binding Path="IsDeviceStatusActive" Converter="{x:Static BoolConverters.Not}"/>
				</MultiBinding>
			</Panel.IsEnabled>
		<!-- Zaglavlje, koraci, tekuća stranica i podnožje u layoutu po veličini prozora (v2 LayoutTemplateSelector). -->
		<c:LayoutContent Content="{Binding}">
			<c:LayoutContent.LandscapeLargeTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowLandscapeLayout/></DataTemplate>
			</c:LayoutContent.LandscapeLargeTemplate>
			<c:LayoutContent.LandscapeMediumTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowLandscapeMediumLayout/></DataTemplate>
			</c:LayoutContent.LandscapeMediumTemplate>
			<c:LayoutContent.LandscapeSmallTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowLandscapeSmallLayout/></DataTemplate>
			</c:LayoutContent.LandscapeSmallTemplate>
			<c:LayoutContent.PortraitLargeTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowPortraitLayout/></DataTemplate>
			</c:LayoutContent.PortraitLargeTemplate>
			<c:LayoutContent.PortraitMediumTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowPortraitMediumLayout/></DataTemplate>
			</c:LayoutContent.PortraitMediumTemplate>
			<c:LayoutContent.PortraitSmallTemplate>
				<DataTemplate x:DataType="vm:MainWindowViewModel"><views:MainWindowPortraitSmallLayout/></DataTemplate>
			</c:LayoutContent.PortraitSmallTemplate>
		</c:LayoutContent>

		<!-- Poruka preko celog ekrana (v2 MessageControl) -->
		<Border Background="Black" Opacity="0.3" IsVisible="{Binding ShowMessage}"/>
		<Border IsVisible="{Binding ShowMessage}"
				Background="{DynamicResource PopupMessageBackgroundColor}"
				BoxShadow="{StaticResource DefaultBoxShadow}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Margin="32">
			<DockPanel>
				<Image DockPanel.Dock="Left"
					   Margin="32 8 8 8"
					   Width="90"
					   VerticalAlignment="Center"
					   Source="{Binding MessageKind, Converter={x:Static c:KioskConverters.MessageIcon}}"/>
				<TextBlock Text="{Binding Message}"
						   AutomationProperties.AutomationId="Message.Text"
						   FontSize="32"
						   Foreground="{DynamicResource PopupMessageForegroundColor}"
						   TextWrapping="Wrap"
						   VerticalAlignment="Center"
						   Padding="32 96 48 96"/>
			</DockPanel>
		</Border>

		<!-- Izbor jezika (v2 LanguageSelector) -->
		<Border IsVisible="{Binding ShowLanguageSelector}"
				Background="#88000000">
			<ItemsControl ItemsSource="{Binding LanguageSelectorViewModel.Languages}"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Center">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:LanguageSelectorItem">
						<Button Classes="animated"
								Margin="12"
								HorizontalAlignment="Stretch"
								AutomationProperties.AutomationId="{Binding LanguageData.LanguageId, StringFormat=Language.{0}}"
								Command="{Binding SelectLanguageCommand}"
								CommandParameter="{Binding LanguageData.LanguageId}">
							<Grid ColumnDefinitions="Auto,*">
								<Image Grid.Column="0" Width="64" VerticalAlignment="Center" Source="{Binding LanguageImage}"/>
								<TextBlock Grid.Column="1"
										   Text="{Binding LanguageData.LanguageDisplayName}"
										   FontWeight="SemiBold"
										   FontSize="48"
										   Margin="24 8"
										   VerticalAlignment="Center"/>
							</Grid>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<ProgressBar IsIndeterminate="True"
					 Height="8"
					 MinHeight="8"
					 Foreground="Orange"
					 VerticalAlignment="Bottom"
					 IsVisible="{Binding ShowProgressBar}"/>

		<TextBlock HorizontalAlignment="Right"
				   VerticalAlignment="Bottom"
				   Background="Black"
				   Foreground="White"
				   FontSize="12"
				   Padding="6,2"
				   Margin="0,0,0,10"
				   Text="{Binding CurrentPageName}"
				   IsVisible="{Binding IsDebugMode}"/>
		</Panel>

		<!-- Status uređaja (dug pritisak na Home; v2 DeviceStatusWindow): van panela kioska, da ga ne ugasi paketomat van funkcije. -->
		<ContentControl Content="{Binding DeviceStatus}"/>
	</Panel>
</Window>