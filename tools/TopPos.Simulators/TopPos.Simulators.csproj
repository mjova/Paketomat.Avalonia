<Project Sdk="Microsoft.NET.Sdk">

  <!-- Konzolni host simulatora bez GUI-ja (server, paketomat ili oba) za E2E i ručni rad; vidi Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TopPos.Simulators.Locker\TopPos.Simulators.Locker.csproj" />
    <ProjectReference Include="..\TopPos.Simulators.Server\TopPos.Simulators.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="serilog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
